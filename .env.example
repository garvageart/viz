# Copy this file to `.env` and fill in secret values.
# Full reference: docs/setup/ENVIRONMENT_VARIABLES.md

# API server
# Runtime environment: development | production
ENV=development
API_PORT=7770
API_HOST=localhost

# Storage
# Root directory for the library, database, cache, and trash
BASE_DIRECTORY=./data
# Sub-directory for upload storage
UPLOAD_LOCATION=library

# Database
# Host the API server reaches Postgres at over the network
# `db` under docker compose; otherwise the database host
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_NAME=viz

# Set a strong/random password for the Postgres user.
# DO NOT leave this empty in production and
# DO NOT use 'postgres' as the password.
# Please use only the characters `A-Za-z0-9`, without special characters or spaces
DB_PASSWORD=""

# Redis
REDIS_PASSWORD=""

# Deployment (docker/docker-compose.prod.yml)
# Container registry host holding the viz-server image. (soon, won't make assumptions about where)
REPO_HOST=somewhereimsure.com
# Registry owner/repo containing the viz-server image (soon)
REPOSITORY=garvageart/viz
# Host path for the PostgreSQL data directory.
DATABASE_LOCATION=/var/lib/postgresql/data
# viz-server image tag to deploy.
IMAGE_TAG=latest
