{
    "tabWidth": 4,
    "useTabs": false,
    "trailingComma": "none",
    "printWidth": 120,
    "plugins": ["@trivago/prettier-plugin-sort-imports", "prettier-plugin-svelte"],
    "importOrder": ["<THIRD_PARTY_MODULES>", "^\\$lib/(.*)$", "^[./]"],
    "importOrderSeparation": false,
    "importOrderSortSpecifiers": true
}
