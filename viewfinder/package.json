{
    "name": "@viz/viewfinder",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "license": "AGPL-3.0",
    "engines": {
        "node": ">=24.13.0"
    },
    "scripts": {
        "generate:icons": "node tools/icon-gen/generate-icons.js",
        "dev": "vite dev --host 0.0.0.0",
        "build:themes": "node tools/build-themes.js",
        "build": "pnpm run generate:icons && pnpm run build:themes && vite build",
        "start": "node build",
        "preview": "vite preview --host",
        "prepare": "svelte-kit sync",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "test:unit": "vitest --passWithNoTests",
        "test": "pnpm run test:unit --run && pnpm run test:e2e",
        "test:e2e": "playwright test --reporter=list",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "gen:api": "oazapfts ../api/openapi/openapi.yaml src/lib/api/client.gen.ts --useEnumType"
    },
    "devDependencies": {
        "@faker-js/faker": "^9.9.0",
        "@fontsource-variable/geist": "^5.2.9",
        "@fontsource-variable/manrope": "^5.2.8",
        "@fontsource-variable/roboto-mono": "^5.2.9",
        "@playwright/test": "^1.59.1",
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.59.1",
        "@sveltejs/vite-plugin-svelte": "^5.1.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/lodash-es": "^4.17.12",
        "@types/luxon": "^3.7.1",
        "@types/node": "^24.12.4",
        "dotenv": "^17.4.2",
        "material-symbols": "^0.44.12",
        "oazapfts": "^6.4.0",
        "openapi-typescript": "^7.5.0",
        "sass": "^1.99.0",
        "svelte": "^5.55.5",
        "svelte-check": "^4.4.8",
        "svgo": "^3.3.3",
        "typescript": "^5.9.3",
        "vite": "^6.4.2",
        "vite-plugin-devtools-json": "^0.1.1",
        "vitest": "^3.2.4"
    },
    "dependencies": {
        "@immich/justified-layout-wasm": "^0.4.3",
        "@internationalized/date": "^3.12.2",
        "@oazapfts/runtime": "^1.2.0",
        "@zoom-image/core": "^0.42.0",
        "@zoom-image/svelte": "^0.3.9",
        "bits-ui": "^2.18.1",
        "comlink": "^4.4.2",
        "dompurify": "^3.4.2",
        "glob": "^13.0.6",
        "handlebars": "^4.7.9",
        "hotkeys-js": "^3.13.15",
        "idb": "^8.0.3",
        "jszip": "^3.10.1",
        "libexif-wasm": "^0.5.3",
        "lodash-es": "^4.18.1",
        "luxon": "^3.7.2",
        "thumbhash": "^0.1.1",
        "tippy.js": "^6.3.7",
        "wasm-vips": "^0.0.18"
    }
}
