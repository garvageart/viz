{
    "name": "@viz/viewfinder",
    "private": true,
    "version": "0.32.9",
    "type": "module",
    "license": "AGPL-3.0",
    "engines": {
        "node": ">=26.5.0"
    },
    "scripts": {
        "generate:icons": "node tools/icon-gen/generate-icons.js",
        "dev": "vite dev --host 0.0.0.0",
        "build:themes": "node tools/build-themes.js",
        "build": "pnpm run build:themes && vite build",
        "start": "node build",
        "preview": "vite preview --host",
        "prepare": "svelte-kit sync",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "test": "pnpm run test:unit --run && pnpm run test:e2e",
        "test:unit": "vitest run",
        "test:e2e": "playwright test --reporter=list",
        "test:e2e:prod": "PLAYWRIGHT_PREVIEW=1 playwright test --reporter=list",
        "test:e2e:prod-build": "pnpm build && PLAYWRIGHT_PREVIEW=1 playwright test --reporter=list",
        "format": "prettier --cache --log-level warn --config .prettierrc --ignore-path .prettierignore --write .",
        "format:check": "prettier --cache --log-level warn --config .prettierrc --ignore-path .prettierignore --check ."
    },
    "devDependencies": {
        "@faker-js/faker": "^10.5.0",
        "@fontsource-variable/geist": "^5.3.0",
        "@fontsource-variable/manrope": "^5.3.0",
        "@fontsource-variable/roboto-mono": "^5.3.0",
        "@playwright/test": "^1.62.1",
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.70.2",
        "@sveltejs/vite-plugin-svelte": "^7.3.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/svelte": "^5.4.2",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/lodash-es": "^4.17.12",
        "@types/luxon": "^3.7.4",
        "@types/node": "^26.2.0",
        "dotenv": "^17.4.2",
        "fake-indexeddb": "^6.2.5",
        "happy-dom": "^20.11.2",
        "material-symbols": "^0.45.10",
        "oazapfts": "^7.5.0",
        "openapi-typescript": "^7.13.0",
        "sass": "^1.102.0",
        "svelte": "^5.56.8",
        "svelte-check": "^4.7.5",
        "svgo": "^4.0.2",
        "typescript": "^6.0.0",
        "vite": "^8.2.1",
        "vite-plugin-devtools-json": "^1.1.0",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "@viz/api": "workspace:*",
        "@immich/justified-layout-wasm": "^0.4.3",
        "@internationalized/date": "^3.12.3",
        "@oazapfts/runtime": "^1.2.0",
        "bits-ui": "^2.18.1",
        "comlink": "^4.4.2",
        "dompurify": "^3.4.13",
        "handlebars": "^4.7.9",
        "hotkeys-js": "^4.0.4",
        "idb": "^8.0.3",
        "jszip": "^3.10.1",
        "libexif-wasm": "^0.5.3",
        "lodash-es": "^4.18.1",
        "luxon": "^3.7.2",
        "thumbhash": "^0.1.1",
        "tippy.js": "^6.3.7",
        "wasm-vips": "^0.0.18"
    }
}
