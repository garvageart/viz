# Stage 1: Frontend Build
FROM node:24-slim AS frontend-builder

WORKDIR /app

# Install pnpm (can be overridden at build time via --build-arg PNPM_VERSION=...)
ARG PNPM_VERSION=latest
RUN npm install -g pnpm@${PNPM_VERSION}

# Copy workspace and frontend files
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY viewfinder/package.json ./viewfinder/
COPY scripts/js/package.json ./scripts/js/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy the rest of the frontend, scripts, and root prettier configuration
COPY viewfinder ./viewfinder
COPY scripts/js ./scripts/js
COPY .prettierrc .prettierignore ./

# Build frontend
WORKDIR /app/viewfinder
RUN pnpm run build

# Stage 2: Backend Build
FROM golang:1.26-bookworm AS backend-builder

# Install build tools and required dependencies to build libvips from source.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    build-essential pkg-config git ca-certificates curl \
    meson ninja-build python3 python3-pip python3-setuptools \
    libglib2.0-dev libexpat1-dev libjpeg-dev libpng-dev libtiff-dev \
    libwebp-dev libheif-dev libopenexr-dev liborc-0.4-dev libgirepository1.0-dev \
    libxml2-dev libexif-dev libpoppler-glib-dev libgsf-1-dev libopenjp2-7-dev \
    libjxl-dev libimagequant-dev libarchive-dev librsvg2-dev \
    libopenslide-dev libmatio-dev libcfitsio-dev libcgif-dev \
    libmagickwand-dev libraw-dev libnifti-dev && \
    rm -rf /var/lib/apt/lists/*

# Download, build and install libvips
COPY .libvips-version /tmp/.libvips-version
RUN set -eux; \
    VIPS_VERSION=$(cat /tmp/.libvips-version | tr -d '[:space:]'); \
    mkdir -p /tmp/build && cd /tmp/build; \
    curl -fsSL "https://github.com/libvips/libvips/releases/download/v${VIPS_VERSION}/vips-${VIPS_VERSION}.tar.xz" -o vips.tar.xz; \
    tar xJf vips.tar.xz; \
    cd vips-${VIPS_VERSION}; \
    meson setup build --prefix=/usr ; \
    ninja -C build; \
    ninja -C build install; \
    rm -rf /tmp/build; \
    ldconfig || true; \
    mkdir -p /vips-libs && cp -d /usr/lib/libvips.so* /usr/lib/*-linux-gnu/libvips.so* /vips-libs/ 2>/dev/null || true

WORKDIR /app

# Copy Go workspace files
COPY go.mod go.sum go.work go.work.sum ./
COPY cmd/api/go.mod cmd/api/go.sum ./cmd/api/

# Accept build arguments for version injection
ARG VERSION
ARG BUILD_ID
ARG BUILD_DATE
ARG SOURCE_COMMIT
ARG SOURCE_REF
ARG SOURCE_URL
ARG REPOSITORY
ARG REPOSITORY_URL

# Download Go dependencies
RUN go mod download

# Copy the rest of the backend code
COPY . .

# Build backend
RUN VERSION=${VERSION:-$(cat version.txt)} && \
    BUILD_DATE=${BUILD_DATE:-$(date -u +"%Y-%m-%dT%H:%M:%SZ")} && \
    go build -ldflags="\
      -X 'viz/internal/config.Version=${VERSION}' \
      -X 'viz/internal/config.BuildID=${BUILD_ID}' \
      -X 'viz/internal/config.RawBuildDate=${BUILD_DATE}' \
      -X 'viz/internal/config.SourceCommit=${SOURCE_COMMIT}' \
      -X 'viz/internal/config.SourceRef=${SOURCE_REF}' \
      -X 'viz/internal/config.SourceUrl=${SOURCE_URL}' \
      -X 'viz/internal/config.Repository=${REPOSITORY}' \
      -X 'viz/internal/config.RepositoryUrl=${REPOSITORY_URL}'" \
    -o /app/viz-server ./cmd/api

# Stage 3: Final Production Image
FROM debian:bookworm-slim

# Install runtime dependencies for libvips
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    libglib2.0-0 libexpat1 libjpeg62-turbo libpng16-16 libtiff6 \
    libwebp7 libheif1 libopenexr-3-1-30 liborc-0.4-0 libgirepository-1.0-1 \
    libxml2 libexif12 libpoppler-glib8 libgsf-1-114 libopenjp2-7 \
    libjxl0.7 libimagequant0 libarchive13 librsvg2-2 libopenslide0 libmatio11 \
    libcfitsio10 libcgif0 libmagickwand-6.q16-6 libraw20 libnifti2-2 \
    ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Copy libvips from backend-builder
COPY --from=backend-builder /vips-libs/ /usr/lib/
RUN ldconfig

WORKDIR /app

# Copy binary and version file from backend-builder
COPY --from=backend-builder /app/viz-server /app/viz-server
COPY --from=backend-builder /app/version.txt /app/version.txt

# Copy built frontend from frontend-builder
COPY --from=frontend-builder /app/build/viewfinder /app/frontend

# Set environment variables
ENV VIZ_FRONTEND_BUILD_PATH=/app/frontend
ENV PORT=7770
ENV BASE_DIRECTORY=/app/var

# Expose the server port
EXPOSE 7770

# Start the application
CMD ["/app/viz-server"]
