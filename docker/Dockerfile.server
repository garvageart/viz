# Stage 1: Frontend Build
FROM node:26-slim AS frontend-builder

WORKDIR /app

# Use modern corepack to manage pnpm instead of global npm installs
ARG PNPM_VERSION=latest
RUN --mount=type=cache,id=npm-cache,target=/root/.npm \
    npm install -g corepack@latest && corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate

# Copy workspace package configuration first for maximum Docker cache hits
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc .prettierrc .prettierignore ./
COPY viewfinder/package.json ./viewfinder/
COPY scripts/js/package.json ./scripts/js/

# Set pnpm store directory, fetch timeout, and retries for CI network resilience
ENV NPM_CONFIG_STORE_DIR=/root/.local/share/pnpm/store
ENV NPM_CONFIG_FETCH_TIMEOUT=600000
ENV NPM_CONFIG_FETCH_RETRIES=5
ENV CI=true

# Install dependencies with BuildKit store cache
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --prod=false

# Copy workspace source code after pnpm install so source edits do not invalidate dependency layer
COPY viewfinder ./viewfinder
COPY scripts/js ./scripts/js

# Build frontend
RUN pnpm --filter @viz/viewfinder run build


# Stage 2: Backend Build
FROM golang:1.26-bookworm AS backend-builder

# Disable apt docker-clean hook so downloaded deb packages persist in BuildKit cache
RUN rm -f /etc/apt/apt.conf.d/docker-clean && \
    echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' > /etc/apt/apt.conf.d/keep-cache

# Install build tools and required dependencies with apt package caching
RUN --mount=type=cache,id=apt-cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=apt-lib,target=/var/lib/apt,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    build-essential pkg-config git ca-certificates curl \
    meson ninja-build python3 python3-pip python3-setuptools \
    libglib2.0-dev libexpat1-dev libjpeg-dev libpng-dev libtiff-dev \
    libwebp-dev libheif-dev libopenexr-dev liborc-0.4-dev libgirepository1.0-dev \
    libxml2-dev libexif-dev libpoppler-glib-dev libgsf-1-dev libopenjp2-7-dev \
    libjxl-dev libimagequant-dev libarchive-dev librsvg2-dev \
    libopenslide-dev libmatio-dev libcfitsio-dev libcgif-dev \
    libmagickwand-dev libraw-dev libnifti-dev

# Download, build and install libvips with BuildKit build cache
COPY .libvips-version /tmp/.libvips-version
RUN --mount=type=cache,id=vips-build-cache,target=/tmp/vips-build-cache,sharing=locked \
    set -eux; \
    VIPS_VERSION=$(cat /tmp/.libvips-version | tr -d '[:space:]'); \
    CACHE_DIR="/tmp/vips-build-cache/vips-${VIPS_VERSION}-installed"; \
    if [ -d "$CACHE_DIR" ] && [ -f "$CACHE_DIR/libvips.so" ]; then \
    echo "Using persistent BuildKit cache for libvips v${VIPS_VERSION}..."; \
    cp -d $CACHE_DIR/*.so* /usr/lib/ 2>/dev/null || true; \
    cp -d $CACHE_DIR/*.so* /usr/lib/*-linux-gnu/ 2>/dev/null || true; \
    mkdir -p /vips-libs && cp -d $CACHE_DIR/*.so* /vips-libs/; \
    ldconfig || true; \
    else \
    mkdir -p /tmp/vips-build-cache && cd /tmp/vips-build-cache; \
    if [ ! -d "vips-${VIPS_VERSION}" ]; then \
    curl -fsSL "https://github.com/libvips/libvips/releases/download/v${VIPS_VERSION}/vips-${VIPS_VERSION}.tar.xz" -o vips.tar.xz; \
    tar xJf vips.tar.xz; \
    fi; \
    cd "vips-${VIPS_VERSION}"; \
    if [ ! -d "build" ]; then \
    meson setup build --prefix=/usr; \
    fi; \
    ninja -C build; \
    ninja -C build install; \
    ldconfig || true; \
    mkdir -p /vips-libs && cp -d /usr/lib/libvips.so* /usr/lib/*-linux-gnu/libvips.so* /vips-libs/ 2>/dev/null || true; \
    mkdir -p "$CACHE_DIR" && cp -d /vips-libs/* "$CACHE_DIR/"; \
    fi

WORKDIR /app

# Copy Go workspace files
COPY go.mod go.sum go.work go.work.sum ./
COPY cmd/api/go.mod cmd/api/go.sum ./cmd/api/

# Download Go dependencies for all workspace modules with persistent BuildKit cache
RUN --mount=type=cache,id=go-pkg,target=/go/pkg/mod,sharing=locked \
    --mount=type=cache,id=go-build,target=/root/.cache/go-build,sharing=locked \
    go mod download -x all && \
    (cd cmd/api && go mod download -x all)

# Copy the rest of the backend code
COPY . .

# Accept build arguments for version injection
ARG VERSION
ARG BUILD_ID
ARG BUILD_DATE
ARG SOURCE_COMMIT
ARG SOURCE_REF
ARG SOURCE_URL
ARG REPOSITORY
ARG REPOSITORY_URL

# Build backend with Go build and module cache
ENV CGO_ENABLED=1
RUN --mount=type=cache,id=go-pkg,target=/go/pkg/mod,sharing=locked \
    --mount=type=cache,id=go-build,target=/root/.cache/go-build,sharing=locked \
    VERSION=${VERSION:-$(cat version.txt)} && \
    BUILD_DATE=${BUILD_DATE:-$(date -u +"%Y-%m-%dT%H:%M:%SZ")} && \
    go build -trimpath -ldflags="-s -w \
    -X 'viz/internal/config.Version=${VERSION}' \
    -X 'viz/internal/config.BuildID=${BUILD_ID}' \
    -X 'viz/internal/config.RawBuildDate=${BUILD_DATE}' \
    -X 'viz/internal/config.SourceCommit=${SOURCE_COMMIT}' \
    -X 'viz/internal/config.SourceRef=${SOURCE_REF}' \
    -X 'viz/internal/config.SourceUrl=${SOURCE_URL}' \
    -X 'viz/internal/config.Repository=${REPOSITORY}' \
    -X 'viz/internal/config.RepositoryUrl=${REPOSITORY_URL}'" \
    -o /app/viz-server ./cmd/api


# Stage 3: Final Production Image
FROM debian:bookworm-slim

# Disable apt docker-clean hook so downloaded deb packages persist in BuildKit cache
RUN rm -f /etc/apt/apt.conf.d/docker-clean && \
    echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' > /etc/apt/apt.conf.d/keep-cache

# Install runtime dependencies for libvips with apt package caching via inline flags
RUN --mount=type=cache,id=apt-cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=apt-lib,target=/var/lib/apt,sharing=locked \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    libglib2.0-0 libexpat1 libjpeg62-turbo libpng16-16 libtiff6 \
    libwebp7 libheif1 libopenexr-3-1-30 liborc-0.4-0 libgirepository-1.0-1 \
    libxml2 libexif12 libpoppler-glib8 libgsf-1-114 libopenjp2-7 \
    libjxl0.7 libimagequant0 libarchive13 librsvg2-2 libopenslide0 libmatio11 \
    libcfitsio10 libcgif0 libmagickwand-6.q16-6 libraw20 libnifti2-2 \
    ca-certificates gosu

# Copy libvips from backend-builder
COPY --from=backend-builder /vips-libs/ /usr/lib/
RUN ldconfig

# non-root user for security
RUN groupadd -r viz && useradd -r -g viz viz

WORKDIR /app

# Copy binary and version file from backend-builder
COPY --from=backend-builder --chown=viz:viz /app/viz-server /app/viz-server
COPY --from=backend-builder --chown=viz:viz /app/version.txt /app/version.txt

# Copy built frontend from frontend-builder
COPY --from=frontend-builder --chown=viz:viz /app/build/viewfinder /app/frontend

# Copy entrypoint script
COPY docker/docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Set ownership
RUN chown -R viz:viz /app

# Set environment variables
ENV VIZ_FRONTEND_BUILD_PATH=/app/frontend
ENV PORT=7770

# Expose the server port
EXPOSE 7770

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["/app/viz-server"]
